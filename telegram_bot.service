[Unit]
Description=Scanner Telegram Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/apikeys
ExecStart=/root/apikeys/venv/bin/python3 -u telegram_bot.py
Restart=always
RestartSec=5
MemoryMax=128M
EnvironmentFile=-/root/apikeys/.env

StandardOutput=append:/root/apikeys/telegram_bot.log
StandardError=append:/root/apikeys/telegram_bot.log

[Install]
WantedBy=multi-user.target
