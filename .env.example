# =============================================================================
# API Key Scanner Configuration
# =============================================================================
# Copy this file to .env and fill in your tokens:
#   cp .env.example .env

# GitHub tokens (comma-separated). Required for GitHub/Gist/Events scanning.
# Create at: https://github.com/settings/tokens (no special scopes needed)
# More tokens = more API quota = faster scanning
GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3

# GitLab tokens (optional, comma-separated). For GitLab code search.
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKENS=glpat_token1,glpat_token2
# Backward-compatible single token format (optional):
# GITLAB_TOKEN=glpat_your_token_here

# --- Scan settings ---
GITHUB_PAGES=5          # Pages per dork (1-10)
GITHUB_PER_PAGE=50      # Results per page (1-100)
GITLAB_PER_PAGE=20      # GitLab results per page (1-100)
WEB_MAX_RESULTS=40      # DuckDuckGo results per dork (1-200)
NPM_SEARCH_SIZE=20      # NPM packages per query (1-250)
HF_SPACES_LIMIT=20      # HuggingFace spaces per query (1-100)

# --- VPS Performance ---
CONCURRENCY_LIMIT=150    # Max concurrent HTTP requests (increase for VPS)
EVENTS_POLL_INTERVAL=30  # GitHub Events poll interval in seconds (10-120)
GIST_POLL_INTERVAL=60    # Public Gist poll interval in seconds (30-300)
SLOW_LOOP_INTERVAL=600   # Deep scan interval in seconds (60-3600, default=10min)
TOKEN_COOLDOWN_SECONDS=65 # Wait before retrying rate-limited token (10-3600)

# --- Output files ---
FUNDED_TXT=funded_keys.txt
EMPTY_TXT=empty_keys.txt
