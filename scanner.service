[Unit]
Description=API Key Scanner (OSINT)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/scanner
ExecStart=/root/scanner/venv/bin/python3 -u key_scanner.py
Restart=always
RestartSec=10
# Prevent OOM kills
OOMScoreAdjust=-500
# Auto-restart if memory exceeds 512MB
MemoryMax=512M
# Env file (optional, for tokens)
EnvironmentFile=-/root/scanner/.env

StandardOutput=append:/root/scanner/scanner.log
StandardError=append:/root/scanner/scanner.log

[Install]
WantedBy=multi-user.target
